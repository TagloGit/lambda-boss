<Project>

  <PropertyGroup>
    <!-- Version — single source of truth for all assemblies -->
    <Version>0.1.4</Version>

    <!-- Enforce code style during build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Analysis settings -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Nullable reference types -->
    <Nullable>enable</Nullable>

    <!-- Warnings -->
    <WarningLevel>9999</WarningLevel>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>

    <!-- Use latest C# language version -->
    <LangVersion>latest</LangVersion>

    <!-- Enable implicit usings -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Implicit usings.

    `<ImplicitUsings>enable</ImplicitUsings>` is a no-op on net48 — the SDK only
    injects the implicit-using set for .NET 5+ TFMs. We list them explicitly here
    so the codebase compiles on net48 with the same surface it had on net6.
  -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

</Project>

/*  FUNCTION NAME:      SetIndex
    DESCRIPTION:*//**Sets the helper-internal INDEX (iteration counter) on a state's meta block. Creates the meta block if absent. Used by REDUCEUNTIL / REDUCEWHILE to track which iteration is current.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-05-02  Claude      Initial version
*/
SetIndex = LAMBDA(
//  Parameter Declarations
    [state],
    [value],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →SetIndex(state, value)¶" &
                "DESCRIPTION:   →Sets the helper-internal INDEX (iteration counter) on a state's meta block. Creates the meta block if absent.¶" &
                "VERSION:       →May 02 2026¶" &
                "PARAMETERS:    →¶" &
                "   state          →(Required) State string. May or may not already have a meta block.¶" &
                "   value          →(Required) Integer iteration index (1-based).¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=SetIndex(SetVars(""x"", 5), 3)¶" &
                "Result         →state with INDEX=3 in the meta block; user variables unchanged¶" &
                "NOTE:          →Internal helper used by REDUCEUNTIL / REDUCEWHILE. Users should not normally call this directly.",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(state),
    //  Procedure
        fs, CHAR(28),
        fsPos, IFERROR(FIND(fs, state), 0),
        metaPart, IF(fsPos = 0, "", LEFT(state, fsPos - 1)),
        userPart, IF(fsPos = 0, state, MID(state, fsPos + 1, LEN(state))),
        newMeta, SetVar(metaPart, "INDEX", value),
        result, newMeta & fs & userPart,
        IF(Help?, Help, result)
)
);

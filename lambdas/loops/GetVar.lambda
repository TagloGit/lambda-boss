/*  FUNCTION NAME:      GetVar
    DESCRIPTION:*//**Reads a named variable from a state string. Returns a native-typed scalar or vertical array based on the entry's type tag.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
                        2026-04-29  Claude      Read per-entry tag and coerce to native type
*/
GetVar = LAMBDA(
//  Parameter Declarations
    [state],
    [name],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →GetVar(state, name)¶" &
                "DESCRIPTION:   →Reads a named variable from a state string. Returns a native-typed scalar or vertical array based on the entry's type tag.¶" &
                "VERSION:       →Apr 29 2026¶" &
                "PARAMETERS:    →¶" &
                "   state          →(Required) State string built with NewState/SetVar/SetVars/SetState.¶" &
                "   name           →(Required) Variable name to read.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=GetVar(SetVar(NewState(), ""x"", 5), ""x"")¶" &
                "Result         →5 (number — element type recovered from the tag)¶" &
                "NOTE:          →Tag values: n=number, b=boolean, t=text. Element type is whatever was passed to SetVar.",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(state),
    //  Procedure
        us, CHAR(31),
        rs, CHAR(30),
        gs, CHAR(29),
        result, IF(state = "", NA(),
                   LET(
                       parts, TEXTSPLIT(state, us),
                       match, @FILTER(parts, LEFT(parts, LEN(name) + 1) = name & rs, ""),
                       IF(match = "", NA(),
                          LET(
                              tag, MID(match, LEN(name) + 2, 1),
                              payload, MID(match, LEN(name) + 4, LEN(match)),
                              raw, IF(ISNUMBER(FIND(gs, payload)), TOCOL(TEXTSPLIT(payload, gs)), payload),
                              IF(tag = "n", --raw, IF(tag = "b", raw = "TRUE", raw))
                          )
                       )
                   )
                ),
        IF(Help?, Help, result)
)
);

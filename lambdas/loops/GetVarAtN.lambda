/*  FUNCTION NAME:      GetVarAtN
    DESCRIPTION:*//**Reads a positional slot and coerces the payload to numeric. Scalar or vertical array.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
*/
GetVarAtN = LAMBDA(
//  Parameter Declarations
    [state],
    [index],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →GetVarAtN(state, index)¶" &
                "DESCRIPTION:   →Reads a positional slot and coerces the payload to numeric. Scalar or vertical array.¶" &
                "VERSION:       →Apr 27 2026¶" &
                "PARAMETERS:    →¶" &
                "   state          →(Required) State string built with SetState (or any state with names ""1""..""N"").¶" &
                "   index          →(Required) 1-based slot number.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=GetVarAtN(SetState(10, 20, 30), 2)¶" &
                "Result         →20 (number). Use GetVarAt for raw text.",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(state),
    //  Procedure
        result, GetVarN(state, index & ""),
        IF(Help?, Help, result)
)
);

/*  FUNCTION NAME:      NewState
    DESCRIPTION:*//**Returns an empty state for use as a REDUCE accumulator with SetVar/GetVar.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
*/
NewState = LAMBDA(
//  Parameter Declarations
    [ShowHelp],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →NewState()¶" &
                "DESCRIPTION:   →Returns an empty state for use as a REDUCE accumulator with SetVar/GetVar.¶" &
                "VERSION:       →Apr 27 2026¶" &
                "PARAMETERS:    →¶" &
                "   ShowHelp       →(Optional) Pass TRUE to show this help text instead of the empty state.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=SetVar(NewState(), ""x"", 5)¶" &
                "Result         →state string holding x=5¶" &
                "NOTE:          →Reads from an empty state return #N/A. For REDUCE, seed with SetState(...) populating the slots iteration 1 will read.",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(ShowHelp),
    //  Procedure
        result, "",
        IF(Help?, result, Help)
)
);

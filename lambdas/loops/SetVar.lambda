/*  FUNCTION NAME:      SetVar
    DESCRIPTION:*//**Sets or replaces a named variable (scalar or 1-D array) in a state string. Records the element type so GetVar returns native types.*/
/*  RETURNS:            state array: the state with the named variable set
    PARAMETERS:
        state           (Required) Current state string. Use NewState() to start fresh.
        name            (Required) Variable name. Cannot contain CHAR(30).
        value           (Required) Scalar or 1-D array. Element type (number, boolean, or text) is recorded in the entry's tag. An error, or an array holding one, is kept: GetVar gives the error back.
    EXAMPLE:            =SetVar(NewState(), "best", 5) -> state string holding best=5 (tagged as number)
    NOTE:               All elements of an array value are assumed to share a type — the tag is set from TYPE of the first element.
    REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
                        2026-04-29  Claude      Add per-entry type tag (n/b/t)
                        2026-11-01  Claude      Deref 1x1-array state/name/value with @: a 1x1 array (e.g. MOVECELL output) made the result array-shaped, and the next TEXTSPLIT kept only its first entry, silently dropping the rest (#376)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
                        2026-11-10  Claude      Keep error values: an entry holding one is tagged e, each element typed, an error as CHAR(28) and its ERROR.TYPE (#442)
*/
SetVar = LAMBDA(
//  Parameter Declarations
    [state],
    [name],
    [value],
    LET(
    //  Procedure
        us, CHAR(31),
        rs, CHAR(30),
        gs, CHAR(29),
        fs, CHAR(28),
        st, @state,
        nm, @name,
        firstVal, @INDEX(value, 1, 1),
        typeCode, TYPE(firstVal),
        plain, IF(ROWS(value) * COLUMNS(value) > 1, TEXTJOIN(gs, FALSE, value), firstVal & ""),
    //  An error can't be joined (an off-grid neighbour in a list of cells). Then the entry is tagged e
    //  and each element carries its own type: n, b or t before its text, or CHAR(28) and its ERROR.TYPE.
        bad?, ISERROR(plain),
        tag, IF(bad?, "e", IF(typeCode = 1, "n", IF(typeCode = 4, "b", "t"))),
        encoded, IF(bad?,
                TEXTJOIN(gs, FALSE, IF(ISERROR(value), fs & ERROR.TYPE(value),
                    IF(ISNUMBER(value), "n", IF(ISLOGICAL(value), "b", "t")) & value)),
                plain
            ),
        newPair, nm & rs & tag & rs & encoded,
        cleaned, IF(st = "", "",
                    LET(
                        parts, TEXTSPLIT(st, us),
                        keep, FILTER(parts, LEFT(parts, LEN(nm) + 1) <> nm & rs, ""),
                        IF(@keep = "", "", TEXTJOIN(us, TRUE, keep))
                    )
                ),
        result, IF(cleaned = "", newPair, cleaned & us & newPair),
        result
)
);

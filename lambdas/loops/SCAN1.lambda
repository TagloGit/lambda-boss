/*  FUNCTION NAME:      SCAN1
    DESCRIPTION:*//**Seedless inclusive scan: uses the first element as the seed, so out[1] equals the first element. No identity value to invent.*/
/*  RETURNS:            array: running accumulator seeded by the first element, same orientation as the input
    PARAMETERS:
        array           (Required) 1-D values; the first element is the seed. Vertical or horizontal; the result matches the orientation.
        fn              (Required) LAMBDA(acc, current) returning the new accumulator.
    EXAMPLE:            =SCAN1({3;7;2;9}, MAX) -> {3;7;7;9} (running maximum)
    REVISIONS:          Date        Developer   Description
                        2026-07-01  Claude      Initial version
                        2026-08-24  Claude      Eta-wrap the user function before passing it as a MAP/SCAN/REDUCE/GROUPBY callback, so relative cell refs in lambda closures survive (#343)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
SCAN1 = LAMBDA(
//  Parameter Declarations
    [array],
    [fn],
    LET(
    //  Procedure
        wasRow, AND(ROWS(array) = 1, COLUMNS(array) > 1),
        flat, TOCOL(array),
        col, IF(ROWS(flat) = 1, flat,
                VSTACK(INDEX(flat, 1, 1), SCAN(INDEX(flat, 1, 1), DROP(flat, 1), LAMBDA(acc_, x_, fn(acc_, x_))))),
        result, IF(wasRow, TRANSPOSE(col), col),
        result
)
);

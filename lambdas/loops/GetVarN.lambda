/*  FUNCTION NAME:      GetVarN
    DESCRIPTION:*//**Reads a named variable and coerces the payload to numeric. Scalar or vertical array.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
*/
GetVarN = LAMBDA(
//  Parameter Declarations
    [state],
    [name],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →GetVarN(state, name)¶" &
                "DESCRIPTION:   →Reads a named variable and coerces the payload to numeric. Scalar or vertical array.¶" &
                "VERSION:       →Apr 27 2026¶" &
                "PARAMETERS:    →¶" &
                "   state          →(Required) State string built with NewState/SetVar/SetVars/SetState.¶" &
                "   name           →(Required) Variable name to read.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=GetVarN(SetVar(NewState(), ""x"", 5), ""x"")¶" &
                "Result         →5 (number). Use GetVar for raw text.",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(state),
    //  Procedure
        result, --GetVar(state, name),
        IF(Help?, Help, result)
)
);

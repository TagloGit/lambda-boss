/*  FUNCTION NAME:      SplitState
    DESCRIPTION:*//**Splits a state (or column of states) into one row of values per state. Scalars are coerced to native types via the per-entry tag; arrays render as [a, b, c]. Optionally prepends a header row of variable names.*/
/*  RETURNS:            array: one row of values per state, columns by variable; optional header row of names
    PARAMETERS:
        state           (Required) Scalar state, or a vertical column of states (e.g. SCAN result).
        IncludeHeaders  (Optional) Pass TRUE to prepend a row of variable names taken from the first state. Defaults to FALSE.
    EXAMPLE:            =SplitState(SCAN(SetState(0,0), SEQUENCE(5), reducer), TRUE) -> (5+1)xN table: header row of variable names, then one row per iteration
    NOTE:               Pair with SCAN to inspect REDUCE state at every iteration. Columns are the first state's variables, in its order; every row is read by name, so a state built in another order still lines up, and a row missing a variable shows #N/A. Array slots are flattened to a [a, b, c] text preview because a 2D output cell can't hold a nested array.
    REVISIONS:          Date        Developer   Description
                        2026-04-27  Claude      Initial version
                        2026-04-29  Claude      Skip past per-entry type tag when extracting payload
                        2026-04-29  Claude      Coerce scalar payloads to native types via tag
                        2026-05-02  Claude      Add IncludeHeaders to prepend a row of variable names
                        2026-11-09  Claude      Read each row by the first state's names, not by position; a missing name gives #N/A (spec 0011 part 5)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
                        2026-11-10  Claude      An entry holding an error shows it in place: as its text in a list, as itself alone (#442)
*/
SplitState = LAMBDA(
//  Parameter Declarations
    [state],
    [IncludeHeaders],
    LET(
    //  Procedure
        us, CHAR(31),
        rs, CHAR(30),
        gs, CHAR(29),
        n, ROWS(state),
        firstState, INDEX(state, 1, 1),
        firstParts, IF(firstState = "", "(empty)", TEXTSPLIT(firstState, us)),
        numVars, COLUMNS(firstParts),
    //  Column c is the first state's c-th name. Every row is read by that name, as GetVar reads it,
    //  so a state whose keys come in another order (a SetVar chain moves a re-set key to the end)
    //  still lines up. A row without the name shows #N/A.
        names, IF(firstState = "", "", TEXTBEFORE(firstParts, rs)),
    //  An entry holding an error (SetVar's tag e) has each element typed, an error as CHAR(28) and
    //  its ERROR.TYPE. A list shows each error as its text in place; a single error shows as itself.
        errorText, {"#NULL!", "#DIV/0!", "#VALUE!", "#REF!", "#NAME?", "#NUM!", "#N/A", "#GETTING_DATA",
            "#SPILL!", "#CONNECT!", "#BLOCKED!", "#UNKNOWN!", "#FIELD!", "#CALC!"},
        showErrors, LAMBDA(payload,
                LET(
                    els, TEXTSPLIT(payload, gs),
                    et, LEFT(els, 1),
                    eb, MID(els, 2, LEN(els)),
                    shown, IF(et = CHAR(28), IFERROR(INDEX(errorText, 1, --eb), "#ERROR"), eb),
                    firstT, INDEX(et, 1, 1),
                    firstB, INDEX(eb, 1, 1),
                    IF(COLUMNS(els) > 1, "[" & TEXTJOIN(", ", FALSE, shown) & "]",
                        IF(firstT = "n", --firstB, IF(firstT = "b", firstB = "TRUE", IF(firstT = "t", firstB,
                            CHOOSE(IF(--firstB > 14, 7, --firstB), #NULL!, #DIV/0!, #VALUE!, #REF!, #NAME?, #NUM!, #N/A, #GETTING_DATA,
                                #N/A, #N/A, #N/A, #N/A, #N/A, FILTER(0, FALSE))))))
                )
            ),
        body, MAKEARRAY(n, numVars, LAMBDA(r, c,
                    LET(
                        s, INDEX(state, r, 1),
                        IF(s = "", "(empty)",
                            LET(
                            //  Match mode 1 ignores case, like GetVar. The key on the end means
                            //  TEXTAFTER always finds it, so a missing name reads as an empty entry.
                                key, us & INDEX(names, 1, c) & rs,
                                entry, TEXTBEFORE(TEXTAFTER(us & s & key, key, 1, 1) & us, us),
                                tag, LEFT(entry, 1),
                                payload, MID(entry, 3, LEN(entry)),
                                IF(entry = "", NA(),
                                    IF(tag = "e", showErrors(payload),
                                    IF(ISNUMBER(FIND(gs, payload)),
                                        "[" & SUBSTITUTE(payload, gs, ", ") & "]",
                                        IF(tag = "n", --payload,
                                            IF(tag = "b", payload = "TRUE", payload)))))
                            )
                        )
                    )
                )),
        wantHeaders?, AND(NOT(ISOMITTED(IncludeHeaders)), IncludeHeaders, firstState <> ""),
        headers, IF(wantHeaders?, names, ""),
        result, IF(wantHeaders?, VSTACK(headers, body), body),
        result
)
);

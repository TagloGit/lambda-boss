/*  FUNCTION NAME:      REDUCE1
    DESCRIPTION:*//**Seedless reduce: folds fn over the list starting from its first element. The identity-less reduction (gcd, max, merge, join) with no seed to invent.*/
/*  RETURNS:            value: fn folded over the array starting from its first element
    PARAMETERS:
        array           (Required) 1-D values; the first element is the seed. Vertical or horizontal.
        fn              (Required) LAMBDA(acc, current) returning the new accumulator.
    EXAMPLE:            =REDUCE1({12;18;30}, GCD) -> 6 (gcd of the whole list)
    REVISIONS:          Date        Developer   Description
                        2026-07-01  Claude      Initial version
                        2026-08-24  Claude      Eta-wrap the user function before passing it as a MAP/SCAN/REDUCE/GROUPBY callback, so relative cell refs in lambda closures survive (#343)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
REDUCE1 = LAMBDA(
//  Parameter Declarations
    [array],
    [fn],
    LET(
    //  Procedure
        flat, TOCOL(array),
        n, ROWS(flat),
        result, IF(n = 1, INDEX(flat, 1, 1), REDUCE(INDEX(flat, 1, 1), DROP(flat, 1), LAMBDA(acc_, x_, fn(acc_, x_)))),
        result
)
);

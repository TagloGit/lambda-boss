/*  FUNCTION NAME:      REDUCE1
    DESCRIPTION:*//**Seedless reduce: folds fn over the list starting from its first element. The identity-less reduction (gcd, max, merge, join) with no seed to invent.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-07-01  Claude      Initial version
*/
REDUCE1 = LAMBDA(
//  Parameter Declarations
    [array],
    [fn],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →REDUCE1(array, fn)¶" &
                "DESCRIPTION:   →Seedless reduce — the final-value twin of SCAN1. Folds fn over the list starting from its first element, so there is no identity/seed to invent for reductions like gcd, max, merge or join.¶" &
                "VERSION:       →Jul 01 2026¶" &
                "PARAMETERS:    →¶" &
                "   array          →(Required) 1-D values; the first element is the seed. Vertical or horizontal.¶" &
                "   fn             →(Required) LAMBDA(acc, current) returning the new accumulator.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=REDUCE1({12;18;30}, GCD)¶" &
                "Result         →6 (gcd of the whole list)",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(array),
    //  Procedure
        flat, TOCOL(array),
        n, ROWS(flat),
        result, IF(n = 1, INDEX(flat, 1, 1), REDUCE(INDEX(flat, 1, 1), DROP(flat, 1), fn)),
        IF(Help?, Help, result)
)
);

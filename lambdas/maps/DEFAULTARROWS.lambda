/*  FUNCTION NAME:      DEFAULTARROWS
    DESCRIPTION:*//**Returns the 8 default compass arrow characters as a vertical array, in canonical clockwise order from north, matching DEFAULTMOVEDELTAS.*/
/*  RETURNS:            8x1 array of arrow glyphs (text), clockwise from north
    PARAMETERS:
        ShowHelp        (Optional) Pass TRUE to show this help text instead of the arrow list.
    EXAMPLE:            =DEFAULTARROWS() -> {↑;↗;→;↘;↓;↙;←;↖}
    REVISIONS:          Date        Developer   Description
                        2026-04-15  Claude      Initial version
                        2026-08-20  Claude      Canonical order is now clockwise from north (= SORT order of the glyphs)
*/
DEFAULTARROWS = LAMBDA(
//  Parameter Declarations
    [ShowHelp],
    LET(
    //  Check inputs
        Help?, ISOMITTED(ShowHelp),
    //  Procedure
        result, {"↑";"↗";"→";"↘";"↓";"↙";"←";"↖"},
    //  Help
        IF(Help?, result, TEXTSPLIT(
                "FUNCTION:      ¦DEFAULTARROWS()¶" &
                "DESCRIPTION:   ¦Returns the 8 default compass arrow characters as a vertical array, in canonical clockwise order from north (the order produced by SORT), matching DEFAULTMOVEDELTAS.¶" &
                "VERSION:       ¦Aug 20 2026¶" &
                "PARAMETERS:    ¦¶" &
                "   ShowHelp       ¦(Optional) Pass TRUE to show this help text instead of the arrow list.¶" &
                "EXAMPLE:       ¦¶" &
                "Formula        ¦=DEFAULTARROWS()¶" &
                "Result         ¦{↑;↗;→;↘;↓;↙;←;↖}",
                "¦", "¶"
                ))
)
);

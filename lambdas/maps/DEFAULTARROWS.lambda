/*  FUNCTION NAME:      DEFAULTARROWS
    DESCRIPTION:*//**Returns the 8 default compass arrow characters as a vertical array, in canonical clockwise order from north, matching _dirAll.*/
/*  RETURNS:            8x1 array of arrow glyphs (text), clockwise from north
    PARAMETERS:
    EXAMPLE:            =DEFAULTARROWS() -> {↑;↗;→;↘;↓;↙;←;↖}
    REVISIONS:          Date        Developer   Description
                        2026-04-15  Claude      Initial version
                        2026-08-20  Claude      Canonical order is now clockwise from north (= SORT order of the glyphs)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
DEFAULTARROWS = LAMBDA(
    LET(
    //  Procedure
        result, {"↑";"↗";"→";"↘";"↓";"↙";"←";"↖"},
        result
)
);

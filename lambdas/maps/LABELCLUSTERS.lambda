/*  FUNCTION NAME:      LABELCLUSTERS
    DESCRIPTION:*//**Labels each input cell with an integer connected-component id, so adjacent cells (directly or transitively) in the same group share an id. Optional pairwise link_fn restricts adjacency to neighbours whose values satisfy a relation. Order-independent via min-label relaxation.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-07-01  Claude      Initial version
                        2026-08-20  Claude      Default stencil re-ordered to the library canonical clockwise-from-north order (result is order-independent; no behaviour change)
                        2026-08-22  Claude      deltas normalised via DIRDELTA so arrow glyphs / compass codes / screen directions are accepted alongside packed deltas
                        2026-09-12  Claude      Added values + link_fn (pairwise adjacency predicate) and headers; params re-ordered; help delimiter switched to ¦ so arrow glyphs no longer break the table
*/
LABELCLUSTERS = LAMBDA(
//  Parameter Declarations
    [cells],
    [values],
    [link_fn],
    [deltas],
    [group],
    [headers],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      ¦LABELCLUSTERS(cells, [values], [link_fn], [deltas], [group], [headers])¶" &
                "DESCRIPTION:   ¦Labels each input cell with an integer cluster id such that two cells in the same group share an id whenever they are adjacent, directly or transitively. Adjacency is geometric (deltas) and, when link_fn is given, also requires the two neighbouring values to satisfy link_fn. Uses full transitive closure (min-label relaxation) so the result is independent of input order. Ids are numbered by first appearance.¶" &
                "VERSION:       ¦Sep 12 2026¶" &
                "PARAMETERS:    ¦¶" &
                "   cells          ¦(Required) A column of cells - A1 address text (e.g. ""B7"") OR encoded scalar positions (row*100000+col). Auto-detected per element via ISNUMBER; text is normalised internally via TOPOS.¶" &
                "   values         ¦(Optional) Column of values parallel to cells, consulted only by link_fn. Omitted: link_fn is ignored and adjacency is purely geometric.¶" &
                "   link_fn        ¦(Optional) LAMBDA(a, b, ...) returning TRUE when two geometrically adjacent cells with values a and b should be linked, e.g. LAMBDA(a, b, a = b) for same-value regions or LAMBDA(a, b, ABS(a - b) <= 1) for smooth regions. Should be symmetric. Linking is transitive (1,2,3 chain into one cluster under the ABS <= 1 rule). Omitted: every geometric neighbour is linked.¶" &
                "   deltas         ¦(Optional) A 1-D array defining connectivity, in any direction notation - packed position deltas (_dirOrthog, _dirAll, knight moves ...), arrow glyphs (_arrowsOrthog, ↑ → ↓ ←), compass codes (N, NE, north-east ...) or screen directions (U, DR, up-left ...); normalised via DIRDELTA. Default: the 8 compass directions in canonical clockwise order ({-100000;-99999;1;100001;100000;99999;-1;-100001}, i.e. _dirAll). Pass _dirOrthog or _arrowsOrthog for 4-way. Assumes the library default mult=100000.¶" &
                "   group          ¦(Optional) Column of area / sheet keys (numeric or text). Adjacency is only tested between cells sharing the same key, so multi-sheet maps stay partitioned. Omitted: all cells treated as one group.¶" &
                "   headers        ¦(Optional) TRUE prepends a ""clusterId"" header to the output (in the output's orientation). Default FALSE.¶" &
                "EXAMPLE:       ¦¶" &
                "Formula        ¦=LABELCLUSTERS({""A1"";""A2"";""A3""}, {1;1;2}, LAMBDA(a, b, a = b))¶" &
                "Result         ¦{1;1;2} (A1 and A2 share value 1 and are adjacent; A3 differs so starts a new cluster)",
                "¦", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(cells),
    //  Procedure
        wasRow, AND(ROWS(cells) = 1, COLUMNS(cells) > 1),
        cellsC, IF(wasRow, TRANSPOSE(cells), cells),
        n, ROWS(cellsC),
        pos, MAP(cellsC, LAMBDA(c_, IF(ISNUMBER(c_), c_, TOPOS(c_)))),
        grpRaw, IF(ISOMITTED(group), SEQUENCE(n, , 0, 0), IF(wasRow, TRANSPOSE(group), group)),
        gi, XMATCH(grpRaw, UNIQUE(grpRaw)),
        BIG, 1000000000000,
        K, gi * BIG + pos,
        dts, IF(ISOMITTED(deltas), {-100000;-99999;1;100001;100000;99999;-1;-100001}, DIRDELTA(deltas)),
        hasLink, AND(NOT(ISOMITTED(values)), NOT(ISOMITTED(link_fn))),
        valsC, IF(ISOMITTED(values), SEQUENCE(n, , 0, 0), IF(wasRow, TRANSPOSE(values), values)),
        linkOk, IF(hasLink, LAMBDA(a_, b_, link_fn(a_, b_)), LAMBDA(a_, b_, TRUE)),
        relaxStep, LAMBDA(lab,
                      REDUCE(lab, dts, LAMBDA(acc, dlt,
                        LET(idx, XMATCH(K + dlt, K),
                            found, ISNUMBER(idx),
                            idxS, IF(found, idx, SEQUENCE(n)),
                            nl, INDEX(lab, idxS),
                            ok, IFERROR(MAP(valsC, INDEX(valsC, idxS), linkOk), FALSE),
                            IF(found * ok, IF(nl < acc, nl, acc), acc))))),
        relax, LAMBDA(self, lab,
                 LET(nxt, relaxStep(lab),
                     IF(SUM(--(nxt <> lab)) = 0, lab, self(self, nxt)))),
        finalLab, relax(relax, SEQUENCE(n)),
        ids, XMATCH(finalLab, SORT(UNIQUE(finalLab))),
        header?, IF(ISOMITTED(headers), FALSE, N(headers) <> 0),
        labelled, IF(header?, VSTACK("clusterId", ids), ids),
        result, IF(wasRow, TRANSPOSE(labelled), labelled),
        IF(Help?, Help, result)
)
);

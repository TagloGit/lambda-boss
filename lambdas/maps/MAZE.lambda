/*  FUNCTION NAME:      MAZE
    DESCRIPTION:*//**Generalized breadth-first / weighted shortest-path search over a grid. The cost surface and walkability mask are the primary inputs — grid shape and position derive from whichever is supplied — with an optional user-supplied per-edge cost LAMBDA.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-05-20  Claude      Initial version (body recreated from issue 184; parameter names preserved)
                        2026-05-20  Claude      Rename internal LET variables for readability; logic and parameter names unchanged
                        2026-05-27  Claude      Mazelam signature now takes cellFrom/cellTo as A1 string addresses instead of separate rowFrom/colFrom/rowTo/colTo numerics
                        2026-05-27  Claude      Mazelam is now guaranteed to receive only in-bounds (cellFrom, cellTo) pairs — off-grid neighbor candidates have their toPos substituted with fromPos before the call. Prevents non-scalar return shapes (e.g. GRIDLOOKUP on an off-grid address) from poisoning the proposals array.
                        2026-07-01  Claude      Add origin parameter (workbook reference; top-left used) so an in-memory map can be anchored to a worksheet position — the coordinate frame (rowArr/colArr, offsets) derives from origin, so st/Targets addresses and the distance grid map into the anchored frame. Matches SUBGRID/GRIDLOOKUP/GRIDAREA convention; replaces the old noRowCol (1,1)-fallback.
                        2026-07-10  Claude      Remove mp parameter — its values were never used, only its shape and position. st is promoted to first (the only always-required argument); grid shape now derives from Costs, else AllowMp, and the default anchor from the first of those that is a workbook reference (origin still overrides). Uniform-cost default switched from mp-mp+1 to SEQUENCE, fixing silently-unreachable text cells. New order: st, Costs, AllowMp, Targets, No_Diag, Show_Steps, Cus_Dir, Mazelam, origin (#299)
                        2026-07-18  Claude      Show_Steps promoted to numeric enum: (0) cumulative cost [default], (1) step counter (TRUE still accepted), (2) path — back-walks the pool's dirDelta predecessor pointers from a single target to return the shortest path as an Nx1 column of A1 addresses
                        2026-07-18  Claude      Fix step counter inflation: the frontier-rows SEQUENCE omitted its step argument, so each proposal's step number gained the source cell's index within the sorted frontier. Now a true zero column — stepNum is uniformly iter+1, i.e. the number of moves on the path
                        2026-07-18  Claude      Help table extracted to MAZEHELP — the combined formula exceeded Excel's 8192-character limit on saved formulas; the Help? branch now delegates via IF(Help?, MAZEHELP(), output)
                        2026-08-20  Claude      Default direction order aligned to the library canonical clockwise-from-north order (changes tie-breaks between equal-cost paths, not distances); Cus_Dir entries may now be any DIRDELTA spelling (arrows, NE, UL, down, ...) as well as numeric deltas
*/
MAZE = LAMBDA(
//  Parameter Declarations
    [st],
    [Costs],
    [AllowMp],
    [Targets],
    [No_Diag],
    [Show_Steps],
    [Cus_Dir],
    [Mazelam],
    [origin],
//  Help — full help table lives in MAZEHELP (the combined formula exceeded Excel's 8192-character limit)
    LET(
    //  Check inputs
        Help?, ISOMITTED(st) + ISOMITTED(Costs) * ISOMITTED(AllowMp),
    //  Procedure
        M, 100000,
        defaultDirs, IF(8 - 4 * No_Diag = 4, {-100000, 1, 100000, -1}, {-100000, -99999, 1, 100001, 100000, 99999, -1, -100001}),
        moveSet, IF(ISOMITTED(Cus_Dir), defaultDirs, TOROW(DIRDELTA(Cus_Dir), 3)),
        nRows, IF(ISOMITTED(Costs), ROWS(AllowMp), ROWS(Costs)),
        nCols, IF(ISOMITTED(Costs), COLUMNS(AllowMp), COLUMNS(Costs)),
        baseRow, IFERROR(IF(ISOMITTED(Costs), NA(), MIN(ROW(Costs))), IFERROR(IF(ISOMITTED(AllowMp), NA(), MIN(ROW(AllowMp))), 1)),
        baseCol, IFERROR(IF(ISOMITTED(Costs), NA(), MIN(COLUMN(Costs))), IFERROR(IF(ISOMITTED(AllowMp), NA(), MIN(COLUMN(AllowMp))), 1)),
        originRow, IF(ISOMITTED(origin), baseRow, MIN(ROW(origin))),
        originCol, IF(ISOMITTED(origin), baseCol, MIN(COLUMN(origin))),
        colArr, SEQUENCE(, nCols, originCol),
        rowArr, SEQUENCE(nRows, , originRow),
        posGrid, rowArr * M + colArr,
        rowOffset, originRow - 1,
        colOffset, originCol - 1,
        naRow, HSTACK(0, 0, 0, 0),
        startPos, TOCOL(ROWNUM(st) * M + COLNUM(st)),
        costGrid, IF(ISOMITTED(Costs), SEQUENCE(nRows, nCols, 1, 0), Costs),
        walkMask, IF(ISOMITTED(AllowMp), SEQUENCE(nRows, nCols, 1, 0) > 0, AllowMp),
        recurse, LAMBDA(self, pool, frontier, iter,
            LET(
                frontPos, TAKE(frontier, , 1),
                frontDist, CHOOSECOLS(frontier, 2),
                frontPrev, CHOOSECOLS(frontier, 4),
                fromPos, TOCOL(frontPos + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                fromRow, INT(fromPos / M) - rowOffset,
                fromCol, MOD(fromPos, M) - colOffset,
                toPos, TOCOL(frontPos + moveSet),
                toRow, INT(toPos / M) - rowOffset,
                toCol, MOD(toPos, M) - colOffset,
                costFrom, INDEX(costGrid, fromRow, fromCol),
                costTo, INDEX(costGrid, toRow, toCol),
                stepNum, TOCOL(SEQUENCE(ROWS(frontier), , 0, 0) + SEQUENCE(, COUNTA(moveSet), iter + 1, 0)),
                distFrom, TOCOL(frontDist + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                dirDelta, TOCOL(moveSet + SEQUENCE(COUNTA(frontPos), , 0, 0)),
                prevDir, TOCOL(frontPrev + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                bestSoFar, IFNA(XLOOKUP(toPos, TAKE(pool, , 1), CHOOSECOLS(pool, 2), , , 2), ""),
                proposals, SORT(
                    IF(
                        toRow * toCol,
                        LET(
                            inBounds, (toRow >= 1) * (toRow <= nRows) * (toCol >= 1) * (toCol <= nCols),
                            safeToPos, IF(inBounds, toPos, fromPos),
                            safeCostTo, IF(inBounds, IFERROR(costTo, costFrom), costFrom),
                            walkOK, IFERROR(INDEX(walkMask, toRow, toCol), 0),
                            stepCost, IF(
                                ISOMITTED(Mazelam),
                                costTo,
                                IFERROR(
                                    Mazelam(
                                        costFrom,
                                        safeCostTo,
                                        ADDRESS(INT(fromPos / M), MOD(fromPos, M), 4),
                                        ADDRESS(INT(safeToPos / M), MOD(safeToPos, M), 4),
                                        distFrom,
                                        dirDelta,
                                        prevDir
                                    ),
                                    NA()
                                )
                            ),
                            IF(
                                walkOK,
                                IFERROR(
                                    IF(
                                        ISNA(stepCost),
                                        naRow,
                                        IF(stepCost + distFrom < bestSoFar, HSTACK(toPos, distFrom + stepCost, stepNum, dirDelta), naRow)
                                    ),
                                    naRow
                                ),
                                naRow
                            )
                        ),
                        naRow
                    ),
                    {1, 2},
                    {1, -1}
                ),
                newFrontier, LET(
                    newKeys, UNIQUE(TAKE(proposals, , 1)),
                    merged, HSTACK(newKeys, VLOOKUP(newKeys, proposals, 2), VLOOKUP(newKeys, proposals, 3), VLOOKUP(newKeys, proposals, 4)),
                    FILTER(merged, TAKE(merged, , 1) > 0, naRow)
                ),
                newPool, LET(
                    poolSorted, SORT(VSTACK(pool, newFrontier), {1, 2}, {1, -1}),
                    poolKeys, UNIQUE(TAKE(poolSorted, , 1)),
                    HSTACK(poolKeys, VLOOKUP(poolKeys, poolSorted, 2), VLOOKUP(poolKeys, poolSorted, 3), VLOOKUP(poolKeys, poolSorted, 4))
                ),
                IF(SUM(newFrontier) = 0, pool, self(self, newPool, newFrontier, iter + 1))
            )
        ),
        seed, IFNA(HSTACK(startPos, 0, 0, 0), 0),
        finalPool, recurse(recurse, seed, seed, 0),
        output, LET(
            mode, IF(ISOMITTED(Show_Steps), 0, Show_Steps * 1),
            IF(
                mode = 2,
                IF(
                    ISOMITTED(Targets),
                    NA(),
                    IF(
                        ROWS(Targets) * COLUMNS(Targets) > 1,
                        NA(),
                        LET(
                            tgtPos, ROWNUM(Targets) * M + COLNUM(Targets),
                            nSteps, VLOOKUP(tgtPos, finalPool, 3, ),
                            posChain, IF(
                                nSteps = 0,
                                tgtPos,
                                REDUCE(tgtPos, SEQUENCE(nSteps), LAMBDA(acc, iter,
                                    LET(
                                        cur, INDEX(acc, 1, 1),
                                        delta, VLOOKUP(cur, finalPool, 4, ),
                                        IF(delta = 0, acc, VSTACK(cur - delta, acc))
                                    )
                                ))
                            ),
                            ADDRESS(INT(posChain / M), MOD(posChain, M), 4)
                        )
                    )
                ),
                LET(
                    outCol, IF(mode = 1, 3, 2),
                    IF(
                        ISOMITTED(Targets),
                        IFNA(VLOOKUP(posGrid, finalPool, outCol, ), ""),
                        MAP(Targets, LAMBDA(tgt, IFNA(VLOOKUP(ROWNUM(tgt) * M + COLNUM(tgt), finalPool, outCol, ), NA())))
                    )
                )
            )
        ),
        IF(Help?, MAZEHELP(), output)
)
);

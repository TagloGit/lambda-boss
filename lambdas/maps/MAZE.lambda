/*  FUNCTION NAME:      MAZE
    DESCRIPTION:*//**Generalized breadth-first / weighted shortest-path search over a grid. Coordinate frame, cost surface, and walkability are separate parameters, with an optional user-supplied per-edge cost LAMBDA.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-05-20  Claude      Initial version (body recreated from issue 184; parameter names preserved)
                        2026-05-20  Claude      Rename internal LET variables for readability; logic and parameter names unchanged
                        2026-05-27  Claude      Mazelam signature now takes cellFrom/cellTo as A1 string addresses instead of separate rowFrom/colFrom/rowTo/colTo numerics
                        2026-05-27  Claude      Mazelam is now guaranteed to receive only in-bounds (cellFrom, cellTo) pairs — off-grid neighbor candidates have their toPos substituted with fromPos before the call. Prevents non-scalar return shapes (e.g. GRIDLOOKUP on an off-grid address) from poisoning the proposals array.
*/
MAZE = LAMBDA(
//  Parameter Declarations
    [mp],
    [st],
    [Cost],
    [Targets],
    [No_Diag],
    [Allowmp],
    [Show_Steps],
    [Cus_Dir],
    [Mazelam],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →MAZE(mp, st, [Cost], [Targets], [No_Diag], [Allowmp], [Show_Steps], [Cus_Dir], [Mazelam])¶" &
                "DESCRIPTION:   →Generalized BFS / weighted shortest-path search over a grid. Coordinate frame, cost surface, and walkability are separate parameters so the function works for icon-text maps, dynamically computed cost surfaces, or simple uniform-cost mazes.¶" &
                "VERSION:       →May 27 2026¶" &
                "PARAMETERS:    →¶" &
                "   mp            →(Required) Map range. Defines the coordinate frame — its ROW/COLUMN determine what addresses like ""Q17"" mean. Values inside mp are not used for cost.¶" &
                "   st            →(Required) Start cell address(es) as A1 text (e.g. ""C3""). Accepts an array of addresses for multi-source BFS.¶" &
                "   Cost          →(Optional) Per-cell step cost, same shape as mp. Defaults to uniform 1 (every step costs 1).¶" &
                "   Targets       →(Optional) A1 address(es) of cells to report distance for. Omitted returns the full distance grid covering all reachable cells.¶" &
                "   No_Diag       →(Optional) TRUE restricts to 4-way movement; default (FALSE) is 8-way including diagonals.¶" &
                "   Allowmp       →(Optional) Boolean walkability mask, same shape as mp. Defaults to everywhere walkable.¶" &
                "   Show_Steps    →(Optional) TRUE returns step count; default returns cumulative cost.¶" &
                "   Cus_Dir       →(Optional) Custom move set as a list of encoded row*100000+col deltas (e.g. KNIGHTDELTAS()).¶" &
                "   Mazelam       →(Optional) LAMBDA(costFrom, costTo, cellFrom, cellTo, distFrom, dirDelta, prevDir) returning per-step cost. cellFrom/cellTo are A1 address strings (e.g. ""Q15""); use ROWNUM/COLNUM or CELLTOPOS to decode. Only invoked on in-bounds (cellFrom, cellTo) pairs — off-grid neighbor candidates are filtered before the call, so implementations need not guard against them. Return NA() to drop an edge.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=MAZE(mp, ""C3"", , , TRUE)¶" &
                "Result         →4-way distance grid from C3 covering all reachable cells in mp",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(mp),
    //  Procedure
        M, 100000,
        defaultDirs, {100000, -100000, 1, -1, 100001, -100001, 99999, -99999},
        moveSet, IF(ISOMITTED(Cus_Dir), TAKE(defaultDirs, , 8 - 4 * No_Diag), TOROW(Cus_Dir, 3)),
        noRowCol, IF(ISERR(@ROW(mp)), 1, 0),
        colArr, IF(noRowCol, SEQUENCE(, COLUMNS(mp)), COLUMN(mp)),
        rowArr, IF(noRowCol, SEQUENCE(ROWS(mp)), ROW(mp)),
        posGrid, rowArr * M + colArr,
        rowOffset, @rowArr - 1,
        colOffset, @colArr - 1,
        naRow, HSTACK(0, 0, 0, 0),
        startPos, TOCOL(ROWNUM(st) * M + COLNUM(st)),
        costGrid, IF(ISOMITTED(Cost), mp - mp + 1, Cost),
        walkMask, IF(ISOMITTED(Allowmp), mp = mp, Allowmp),
        recurse, LAMBDA(self, pool, frontier, iter,
            LET(
                frontPos, TAKE(frontier, , 1),
                frontDist, CHOOSECOLS(frontier, 2),
                frontPrev, CHOOSECOLS(frontier, 4),
                fromPos, TOCOL(frontPos + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                fromRow, INT(fromPos / M) - rowOffset,
                fromCol, MOD(fromPos, M) - colOffset,
                toPos, TOCOL(frontPos + moveSet),
                toRow, INT(toPos / M) - rowOffset,
                toCol, MOD(toPos, M) - colOffset,
                costFrom, INDEX(costGrid, fromRow, fromCol),
                costTo, INDEX(costGrid, toRow, toCol),
                stepNum, TOCOL(SEQUENCE(ROWS(frontier), , 0) + SEQUENCE(, COUNTA(moveSet), iter + 1, 0)),
                distFrom, TOCOL(frontDist + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                dirDelta, TOCOL(moveSet + SEQUENCE(COUNTA(frontPos), , 0, 0)),
                prevDir, TOCOL(frontPrev + SEQUENCE(, COUNTA(moveSet), 0, 0)),
                bestSoFar, IFNA(XLOOKUP(toPos, TAKE(pool, , 1), CHOOSECOLS(pool, 2), , , 2), ""),
                proposals, SORT(
                    IF(
                        toRow * toCol,
                        LET(
                            inBounds, (toRow >= 1) * (toRow <= ROWS(mp)) * (toCol >= 1) * (toCol <= COLUMNS(mp)),
                            safeToPos, IF(inBounds, toPos, fromPos),
                            safeCostTo, IF(inBounds, IFERROR(costTo, costFrom), costFrom),
                            walkOK, IFERROR(INDEX(walkMask, toRow, toCol), 0),
                            stepCost, IF(
                                ISOMITTED(Mazelam),
                                costTo,
                                IFERROR(
                                    Mazelam(
                                        costFrom,
                                        safeCostTo,
                                        ADDRESS(INT(fromPos / M), MOD(fromPos, M), 4),
                                        ADDRESS(INT(safeToPos / M), MOD(safeToPos, M), 4),
                                        distFrom,
                                        dirDelta,
                                        prevDir
                                    ),
                                    NA()
                                )
                            ),
                            IF(
                                walkOK,
                                IFERROR(
                                    IF(
                                        ISNA(stepCost),
                                        naRow,
                                        IF(stepCost + distFrom < bestSoFar, HSTACK(toPos, distFrom + stepCost, stepNum, dirDelta), naRow)
                                    ),
                                    naRow
                                ),
                                naRow
                            )
                        ),
                        naRow
                    ),
                    {1, 2},
                    {1, -1}
                ),
                newFrontier, LET(
                    newKeys, UNIQUE(TAKE(proposals, , 1)),
                    merged, HSTACK(newKeys, VLOOKUP(newKeys, proposals, 2), VLOOKUP(newKeys, proposals, 3), VLOOKUP(newKeys, proposals, 4)),
                    FILTER(merged, TAKE(merged, , 1) > 0, naRow)
                ),
                newPool, LET(
                    poolSorted, SORT(VSTACK(pool, newFrontier), {1, 2}, {1, -1}),
                    poolKeys, UNIQUE(TAKE(poolSorted, , 1)),
                    HSTACK(poolKeys, VLOOKUP(poolKeys, poolSorted, 2), VLOOKUP(poolKeys, poolSorted, 3), VLOOKUP(poolKeys, poolSorted, 4))
                ),
                IF(SUM(newFrontier) = 0, pool, self(self, newPool, newFrontier, iter + 1))
            )
        ),
        seed, IFNA(HSTACK(startPos, 0, 0, 0), 0),
        finalPool, recurse(recurse, seed, seed, 0),
        output, LET(
            outCol, IF(ISOMITTED(Show_Steps), 2, 3),
            IF(
                ISOMITTED(Targets),
                IFNA(VLOOKUP(posGrid, finalPool, outCol, ), ""),
                MAP(Targets, LAMBDA(tgt, IFNA(VLOOKUP(ROWNUM(tgt) * M + COLNUM(tgt), finalPool, outCol, ), NA())))
            )
        ),
        IF(Help?, Help, output)
)
);

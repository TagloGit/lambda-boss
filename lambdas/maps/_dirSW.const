/*  CONSTANT NAME:      _dirSW
    DESCRIPTION:*//**The scalar position-delta for south-west (down-left): rowDelta +1, colDelta -1 encoded as rowDelta*_mult+colDelta (derived from _mult, so it follows the one multiplier). Arrow twin: _arrowSW.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-08-20  Claude      Initial version
                        2026-11-06  Claude      Derived from _mult instead of a literal 100000 (#380)
*/
_dirSW = _mult - 1;

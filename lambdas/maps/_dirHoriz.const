/*  CONSTANT NAME:      _dirHoriz
    DESCRIPTION:*//**The 2 scalar position-deltas for the horizontal directions, as a vertical array in canonical clockwise order from north (right, left) matching _arrowsHoriz. Each is a single integer to add to a CELLTOPOS position (column ±1; mult-independent).*/
/*  REVISIONS:          Date        Developer   Description
                        2026-06-19  Claude      Initial version
                        2026-08-20  Claude      Canonical order is now clockwise from north (= SORT order of _arrowsAll)
*/
_dirHoriz = {1;-1};

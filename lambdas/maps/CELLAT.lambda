/*  FUNCTION NAME:      CELLAT
    DESCRIPTION:*//**Builds a relative A1 address string from a row and column number. Inverse of ROWNUM/COLNUM.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-06-16  Claude      Initial version
*/
CELLAT = LAMBDA(
//  Parameter Declarations
    [row],
    [col],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →CELLAT(row, col)¶" &
                "DESCRIPTION:   →Builds a relative A1 address string (no $) from a row and column number. The (row,col)->address converter; inverse of ROWNUM/COLNUM. A thin, family-consistent wrapper over ADDRESS.¶" &
                "VERSION:       →Jun 16 2026¶" &
                "PARAMETERS:    →¶" &
                "   row            →(Required) Row number. Also accepts an array of rows — result lifts element-wise (and broadcasts against col).¶" &
                "   col            →(Required) Column number. Also accepts an array of cols — result lifts element-wise (and broadcasts against row).¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=CELLAT(5, 5)¶" &
                "Result         →E5",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(row),
    //  Procedure
        result, ADDRESS(row, col, 4),
        IF(Help?, Help, result)
)
);

/*  FUNCTION NAME:      CELLAT
    DESCRIPTION:*//**Builds a relative A1 address string from a row and column number. Inverse of ROWNUM/COLNUM.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-06-16  Claude      Initial version
                        2026-11-06  Claude      ADDRESS-free: column letters by bijective base 26, so columns past XFD and rows past 1048576 work (ADDRESS stops at XFD1048576) (#380)
*/
CELLAT = LAMBDA(
//  Parameter Declarations
    [row],
    [col],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →CELLAT(row, col)¶" &
                "DESCRIPTION:   →Builds a relative A1 address string (no $) from a row and column number. The (row,col)->address converter; inverse of ROWNUM/COLNUM. Works past column XFD and row 1048576 (no ADDRESS inside), e.g. CELLAT(1, 16385) = XFE1.¶" &
                "VERSION:       →Nov 06 2026¶" &
                "PARAMETERS:    →¶" &
                "   row            →(Required) Row number (1 or more; decimals are truncated, as ADDRESS does; below 1 gives #VALUE!). Any size. Also accepts an array of rows — result lifts element-wise (and broadcasts against col).¶" &
                "   col            →(Required) Column number (1 or more; below 1 gives #VALUE!). Up to 7 letters (8353082582, ZZZZZZZ; beyond gives #NUM!): 16385 is XFE, 475254 is ZZZZ. Also accepts an array of cols — result lifts element-wise (and broadcasts against row).¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=CELLAT(5, 5)¶" &
                "Result         →E5",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(row),
    //  Procedure
        rowB, INT(row + 0 * col),
        colB, INT(col + 0 * row),
        one, LAMBDA(rr, cc,
               IF(OR(rr < 1, cc < 1), #VALUE!,
                  IF(cc > 8353082582, #NUM!,
                  LET(nL, 1 + (cc > 26) + (cc > 702) + (cc > 18278) + (cc > 475254) + (cc > 12356630) + (cc > 321272406),
                      v, cc - 1 - (26 ^ nL - 26) / 25,
                      CONCAT(CHAR(65 + MOD(INT(v / 26 ^ (nL - SEQUENCE(nL))), 26))) & rr)))),
        result, IF(AND(ROWS(rowB) = 1, COLUMNS(rowB) = 1), one(@rowB, @colB), MAP(rowB, colB, one)),
        IF(Help?, Help, result)
)
);

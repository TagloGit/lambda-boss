/*  CONSTANT NAME:      _dirN
    DESCRIPTION:*//**The scalar position-delta for north (up): rowDelta -1 encoded as rowDelta*_mult+colDelta (derived from _mult, so it follows the one multiplier). Arrow twin: _arrowN.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-08-20  Claude      Initial version
                        2026-11-06  Claude      Derived from _mult instead of a literal 100000 (#380)
*/
_dirN = -_mult;

/*  FUNCTION NAME:      TLOOKUP
    DESCRIPTION:*//**Looks up a value from a header-row table by matching a row key in one column and returning the value under a named header. Several items and several headers give a grid.*/
/*  RETURNS:            value: the value under HeaderName for each Item; items down a column x headers along a row give an items x headers grid (row mode: the matched row)
    PARAMETERS:
        Table           (Required) Full table including its header row (e.g. tblData[#All]). Row mode (HeaderName omitted) also accepts a data-only table (e.g. tblData).
        Item            (Optional) Value to find in LookupCol to identify the row. Also accepts an array of items (any shape; row mode stacks one row per item). With several items and/or headers, Item and HeaderName broadcast like arithmetic: items in a column x headers in a row = items x headers grid; a row of items x a column of headers = the same grid transposed; two lists of the same orientation and length pair up element by element; one item x several headers = one row (or column). If omitted, returns the whole data column(s) under HeaderName (header row excluded); several headers sit side by side.
        LookupCol       (Optional) Column to search for Item (e.g. tblData[Person]). Excluding headers. Defaults to the first column of Table.
        HeaderName      (Optional) Header text identifying the column whose value should be returned. Accepts a list of headers (e.g. HSTACK(D7,B7) or {"Age","City"}), in any order. If omitted (row mode), returns the matched row; when LookupCol is also omitted the first (key) column is dropped from the result. Note: in row mode an Item equal to the header text matches the header row - pass a data-only Table if keys could collide with headers.
        If_not_found    (Optional) Value to return when Item or HeaderName is not found. Applies per cell in a grid (and to cells beyond the shorter list when two same-orientation lists differ in length). Defaults to #N/A.
        Match_mode      (Optional) XMATCH match mode for Item: (0) exact, (-1) exact-or-next-smaller, (1) exact-or-next-larger, (2) wildcard. If Match_mode and Search_mode are both omitted, Item matches with MATCH exact match (wildcards * ? ~ honoured), as before.
        Search_mode     (Optional) XMATCH search mode for Item: (1) first-to-last [default], (-1) last-to-first, (2) binary ascending, (-2) binary descending.
        Case_sensitive  (Optional) TRUE for a case-sensitive exact match on Item (R is not r); Match_mode and Search_mode are then ignored. Headers always match case-insensitively. Default FALSE.
    EXAMPLE:            =TLOOKUP(tblData[#All], {"Tim";"Sam"}, , {"Age","City"}) -> {42,"Sydney";30,"Melbourne"}
    REVISIONS:          Date        Developer   Description
                        2026-05-07  Claude      Initial version
                        2026-05-14  Claude      Array-lift on Item via dispatcher: MAP over multi-item input, otherwise scalar body unchanged
                        2026-07-18  Claude      Item now optional (omitted returns whole data column under HeaderName); LookupCol now optional (defaults to first table column)
                        2026-07-18  Claude      Row mode: omitted HeaderName returns the matched row's other columns; works with or without a header row; array Items stack rows
                        2026-07-22  Claude      1x1-array Item handling: both modes deref Item with @ on the scalar path (INDEX with a lifted 1x1 row index collapsed row mode's whole-row return); @ also keeps column mode's scalar output a true scalar (#318)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
                        2026-11-27  Claude      HeaderName accepts a list: one MATCH of items, one MATCH of headers, one INDEX that broadcasts to a grid (no per-item MAP); whole-column mode returns several columns; Match_mode, Search_mode, Case_sensitive added (from XV); row mode with several items, one missing and no If_not_found now gives that row #N/A instead of collapsing the whole result to #N/A
*/
TLOOKUP = LAMBDA(
//  Parameter Declarations
    [Table],
    [Item],
    [LookupCol],
    [HeaderName],
    [If_not_found],
    [Match_mode],
    [Search_mode],
    [Case_sensitive],
    LET(
    //  Procedure
        notFound, IF(ISOMITTED(If_not_found), NA(), If_not_found),
    //  Item matching: MATCH exact (as before) unless a match/search mode or case sensitivity is asked for.
        caseSens, IF(ISOMITTED(Case_sensitive), FALSE, Case_sensitive),
        plain?, AND(ISOMITTED(Match_mode), ISOMITTED(Search_mode)),
        mMode, IF(ISOMITTED(Match_mode), 0, Match_mode),
        sMode, IF(ISOMITTED(Search_mode), 1, Search_mode),
        csPos, LAMBDA(x, col, MATCH(TRUE, EXACT(col, x), 0)),
        posOf, LAMBDA(v, col,
                 IF(caseSens,
                    IF(AND(ROWS(v) = 1, COLUMNS(v) = 1), csPos(@v, col), MAP(v, LAMBDA(x, csPos(x, col)))),
                    IF(plain?, MATCH(v, col, 0), XMATCH(v, col, mMode, sMode)))),
        lookCol, IF(ISOMITTED(LookupCol), DROP(TAKE(Table, , 1), 1), LookupCol),
        colIdx, MATCH(HeaderName, INDEX(Table, 1, ), 0),
        multiHdr?, IF(ISOMITTED(HeaderName), FALSE, OR(ROWS(HeaderName) > 1, COLUMNS(HeaderName) > 1)),
    //  Whole-column mode (Item omitted): one header -> its data column; several -> those columns side by side.
        wholeCol, LAMBDA(
                    IF(multiHdr?,
                       IFERROR(INDEX(DROP(Table, 1), SEQUENCE(ROWS(Table) - 1), TOROW(colIdx)), notFound),
                       IFERROR(DROP(INDEX(Table, , colIdx), 1), notFound))),
        scalar, LAMBDA(it, IFERROR(INDEX(Table, posOf(it, lookCol) + 1, colIdx), notFound)),
    //  Several items and/or headers: match all at once, then one INDEX broadcasts rows x columns.
        grid, LAMBDA(IFERROR(INDEX(Table, posOf(Item, lookCol) + 1, colIdx), notFound)),
    //  Row mode: HeaderName omitted - match Item against the lookup column and return the whole row.
    //  With LookupCol omitted, match spans the full first column (a header row simply never matches),
    //  so headered and header-less tables both work; the key column is dropped from the result.
    //  With LookupCol given (data-only by convention), the row-count difference vs Table supplies the offset.
        keyDropped?, ISOMITTED(LookupCol),
        fullLook, IF(ISOMITTED(LookupCol), TAKE(Table, , 1), LookupCol),
        rowOffset, ROWS(Table) - ROWS(fullLook),
        rowWidth, COLUMNS(Table) - IF(keyDropped?, 1, 0),
        rowFor, LAMBDA(it,
                  LET(fullRow, INDEX(Table, posOf(it, fullLook) + rowOffset, ),
                      IF(keyDropped?, DROP(fullRow, , 1), fullRow))),
        rowResult, LAMBDA(
                    IF(OR(ROWS(Item) > 1, COLUMNS(Item) > 1),
                      DROP(REDUCE(0, Item, LAMBDA(acc, it,
                          VSTACK(acc, IFERROR(rowFor(it), IF(SEQUENCE(1, rowWidth), notFound))))), 1),
                      IFERROR(rowFor(@Item), notFound))),
        result, IF(AND(ISOMITTED(HeaderName), NOT(ISOMITTED(Item))),
                    rowResult(),
                    IF(ISOMITTED(Item),
                        wholeCol(),
                        IF(OR(multiHdr?, ROWS(Item) > 1, COLUMNS(Item) > 1),
                            grid(),
                            scalar(@Item)))),
        result
)
);

/*  FUNCTION NAME:      ChannelProbe
    DESCRIPTION:*//**Temporary proof that the Labs channel reads develop. Removed before the first release.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-11-06  Claude      Initial version
*/
ChannelProbe = LAMBDA(
//  Parameter Declarations
    [ShowHelp],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →ChannelProbe()¶" &
                "DESCRIPTION:   →Temporary proof that the Labs channel reads develop.¶" &
                "VERSION:       →Nov 06 2026¶" &
                "PARAMETERS:    →¶" &
                "   ShowHelp       →(Optional) Pass TRUE to show this help text.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=ChannelProbe()¶" &
                "Result         →read from develop",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(ShowHelp),
    //  Procedure
        result, "read from develop",
        IF(Help?, result, Help)
)
);

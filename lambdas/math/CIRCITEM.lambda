/*  FUNCTION NAME:      CIRCITEM
    DESCRIPTION:*//**The item moves places after item in a circular list (turn order, rota, next player), wrapping round at the end.*/
/*  RETURNS:            value: the item moves places after item in items, wrapping round; lifts over arrays of item or moves, keeping item's shape
    PARAMETERS:
        item            (Required) The item to start from. Scalar or array: CIRCITEM(players, players) gives each player's successor. Exact match, case-insensitive (as XMATCH); numbers and text both work. Not in items: #N/A. Duplicates in items: the first match is used.
        items           (Required) The circular list: a row or a column. A 2-D range is read in reading order (row by row, as TOCOL).
        moves           (Optional) Places to move. Default 1 (the next item); -1 = the previous one; 0 = item itself; any size wraps (MOD). Scalar or array.
    EXAMPLE:            =CIRCITEM("Cal", {"Ann";"Bea";"Cal"}) -> "Ann"
    REVISIONS:          Date        Developer   Description
                        2026-11-26  Claude      Initial version
*/
CIRCITEM = LAMBDA(
//  Parameter Declarations
    [item],
    [items],
    [moves],
    LET(
    //  Check inputs
        Moves, IF(ISOMITTED(moves), 1, moves),
        List, TOCOL(items),
        n, ROWS(List),
    //  Procedure
        pos, XMATCH(item, List),
        result, INDEX(List, MOD(pos - 1 + Moves, n) + 1, 1),
        result
)
);

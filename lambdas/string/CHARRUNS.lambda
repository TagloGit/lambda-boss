/*  FUNCTION NAME:      CHARRUNS
    DESCRIPTION:*//**Decomposes a string into an array of consecutive-character run groups. Grapheme-aware: a repeated multi-codepoint emoji forms one run.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-15  Tim Jacks   Initial version (as CONSECGROUPS)
                        2026-07-28  Claude      Renamed CONSECGROUPS -> CHARRUNS (run-family naming consolidation, #322)
                        2026-08-16  Claude      Add case_insensitive argument (0 = case-sensitive [default], 1 = case-insensitive), library convention
                        2026-08-17  Claude      Grapheme-aware: group runs of \X clusters, not code points, so a repeated multi-codepoint emoji forms one run
*/
CHARRUNS = LAMBDA(
//  Parameter Declarations
    [input],
    [case_insensitive],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →CHARRUNS(input, case_insensitive)¶" &
                "DESCRIPTION:   →Decomposes a string into an array of consecutive-character run groups. String twin of the array run family (RUNPOS, RUNSIZE, RUNGROUPS, RUNGROUPBY). Grapheme-aware: a repeated multi-codepoint emoji forms one run.¶" &
                "VERSION:       →Aug 17 2026¶" &
                "PARAMETERS:    →¶" &
                "   input          →(Required) A string to decompose into consecutive groups.¶" &
                "   case_insensitive →(Optional) (0) case-sensitive [default], (1) case-insensitive: runs group across case, e.g. ""Aa"" is one run (original casing preserved in output).¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=CHARRUNS(""AABBBCA"")¶" &
                "Result         →{""AA"";""BBB"";""C"";""A""}",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(input),
        _ci, IF(ISOMITTED(case_insensitive), 0, case_insensitive),
    //  Procedure
        result, TRANSPOSE(REGEXEXTRACT(input, "(\X)\1*", 1, _ci)),
        IF(Help?, Help, result)
)
);

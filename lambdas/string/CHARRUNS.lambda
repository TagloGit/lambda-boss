/*  FUNCTION NAME:      CHARRUNS
    DESCRIPTION:*//**Decomposes a string into an array of consecutive-character run groups.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-15  Tim Jacks   Initial version (as CONSECGROUPS)
                        2026-07-28  Claude      Renamed CONSECGROUPS -> CHARRUNS (run-family naming consolidation, #322)
*/
CHARRUNS = LAMBDA(
//  Parameter Declarations
    [input],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →CHARRUNS(input)¶" &
                "DESCRIPTION:   →Decomposes a string into an array of consecutive-character run groups. String twin of the array run family (RUNPOS, RUNSIZE, RUNGROUPS, RUNGROUPBY).¶" &
                "VERSION:       →Jul 28 2026¶" &
                "PARAMETERS:    →¶" &
                "   input          →(Required) A string to decompose into consecutive groups.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=CHARRUNS(""AABBBCA"")¶" &
                "Result         →{""AA"";""BBB"";""C"";""A""}",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(input),
    //  Procedure
        result, TRANSPOSE(REGEXEXTRACT(input, "(.)\1*", 1)),
        IF(Help?, Help, result)
)
);

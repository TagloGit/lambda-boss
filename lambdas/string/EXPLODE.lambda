/*  FUNCTION NAME:      EXPLODE
    DESCRIPTION:*//**Splits a string into an array of character chunks of a given size, optionally as sliding windows.*/
/*  REVISIONS:          Date        Developer   Description
                        2026-04-12  Tim Jacks   Initial version
                        2026-08-16  Claude      Add sliding window option
*/
EXPLODE = LAMBDA(
//  Parameter Declarations
    [text],
    [chunk_size],
    [horizontal],
    [sliding],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →EXPLODE(text, chunk_size, horizontal, sliding)¶" &
                "DESCRIPTION:   →Splits a string into an array of character chunks of a given size, optionally as sliding windows.¶" &
                "VERSION:       →Aug 16 2026¶" &
                "PARAMETERS:    →¶" &
                "   text           →(Required) The string to split.¶" &
                "   chunk_size     →(Optional) Number of characters per chunk. Default: 1.¶" &
                "   horizontal     →(Optional) If TRUE, returns a horizontal row array. Default: FALSE.¶" &
                "   sliding        →(Optional) If TRUE, the window start shifts by 1 each time instead of by chunk_size, returning only full windows. Text shorter than chunk_size returns the whole string. Default: FALSE.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=EXPLODE(""abcdef"", 3, , TRUE)¶" &
                "Result         →{""abc"";""bcd"";""cde"";""def""}",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(text),
        _size, IF(ISOMITTED(chunk_size), 1, chunk_size),
        _horiz, IF(ISOMITTED(horizontal), FALSE, horizontal),
        _slide, IF(ISOMITTED(sliding), FALSE, sliding),
    //  Procedure
        _count, IF(_slide,
                    MAX(LEN(text) - _size + 1, 1),
                    CEILING(LEN(text) / _size, 1)),
        _step, IF(_slide, 1, _size),
        _starts, IF(_horiz,
                    SEQUENCE(1, _count, 1, _step),
                    SEQUENCE(_count, 1, 1, _step)),
        result, MID(text, _starts, _size),
        IF(Help?, Help, result)
)
);

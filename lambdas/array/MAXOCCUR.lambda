/*  FUNCTION NAME:      MAXOCCUR
    DESCRIPTION:*//**Returns the value that occurs most often in an array.*/
/*  RETURNS:            value: the value that occurs most often in the array
    PARAMETERS:
        array           (Required) A 1D array of values to tally.
    EXAMPLE:            =MAXOCCUR({"A","A","B","B","B","C"}) -> B
    REVISIONS:          Date        Developer   Description
                        2026-04-15  Claude      Initial version
*/
MAXOCCUR = LAMBDA(
//  Parameter Declarations
    [array],
    LET(
    //  Check inputs
        Help?, ISOMITTED(array),
    //  Procedure
        _arr, IF(ROWS(array)=1, TRANSPOSE(array), array),
        result, INDEX(GROUPBY(_arr, _arr, ROWS, , 0, -2), 1, 1),
    //  Help
        IF(Help?, TEXTSPLIT(
                "FUNCTION:      →MAXOCCUR(array)¶" &
                "DESCRIPTION:   →Returns the value that occurs most often in an array. Ties broken by first-seen.¶" &
                "VERSION:       →Apr 15 2026¶" &
                "PARAMETERS:    →¶" &
                "   array          →(Required) A 1D array of values to tally.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=MAXOCCUR({""A"",""A"",""B"",""B"",""B"",""C""})¶" &
                "Result         →B",
                "→", "¶"
                ), result)
)
);

/*  FUNCTION NAME:      WRITEAT
    DESCRIPTION:*//**Overwrites the element at a 1-based position in a 1-D array, preserving its length. The overwrite-counterpart to INSERTAT.*/
/*  RETURNS:            array: the 1-D array with the element at pos replaced, same length and orientation
    PARAMETERS:
        array           (Required) 1-D array. Treated as a row when ROWS(array)=1 and COLUMNS(array)>1; otherwise as a column.
        value           (Required) Scalar to write at pos.
        pos             (Required) 1-based position to overwrite. Out-of-range positions return #N/A.
    EXAMPLE:            =WRITEAT({"a";"b";"c"}, "X", 1) -> {"X";"b";"c"}
    REVISIONS:          Date        Developer   Description
                        2026-05-04  Claude      Initial version
                        2026-06-16  Claude      Recast as a 1-D mirror of INSERTAT: single ordinal pos, overwrite in place; 2-D overwrite now belongs to REPLACEARRAY
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
WRITEAT = LAMBDA(
//  Parameter Declarations
    [array],
    [value],
    [pos],
    LET(
    //  Procedure
        horiz, AND(ROWS(array) = 1, COLUMNS(array) > 1),
        len, IF(horiz, COLUMNS(array), ROWS(array)),
        idx, SEQUENCE(IF(horiz, 1, len), IF(horiz, len, 1)),
        result, IF(OR(pos < 1, pos > len), NA(), IF(idx = pos, value, array)),
        result
)
);

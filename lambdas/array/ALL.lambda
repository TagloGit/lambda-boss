/*  FUNCTION NAME:      ALL
    DESCRIPTION:*//**Returns TRUE if every item satisfies the predicate, else FALSE.*/
/*  RETURNS:            TRUE/FALSE: whether every item passes the test
    PARAMETERS:
        items           (Required) Array or range of values to test.
        predicate       (Optional) LAMBDA(v) returning TRUE/FALSE or 0/1. If omitted, items are assumed to already be boolean or 0/1 values.
    EXAMPLE:            =ALL({"A","B","C"}, LAMBDA(c, CODE(c)>=65)) -> TRUE
    REVISIONS:          Date        Developer   Description
                        2026-05-28  Claude      Initial version
                        2026-08-24  Claude      Eta-wrap the user function before passing it as a MAP/SCAN/REDUCE/GROUPBY callback, so relative cell refs in lambda closures survive (#343)
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
ALL = LAMBDA(
//  Parameter Declarations
    [items],
    [predicate],
    LET(
    //  Procedure
        pred, IF(ISOMITTED(predicate), LAMBDA(val, val), predicate),
        mapped, MAP(items, LAMBDA(x_, pred(x_))),
        result, SUM(--NOT(mapped))=0,
        result
)
);

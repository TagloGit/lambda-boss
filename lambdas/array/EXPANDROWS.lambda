/*  FUNCTION NAME:      EXPANDROWS
    DESCRIPTION:*//**One row becomes several: runs a function on each cell of one column and repeats the rest of that row once per value it returns.*/
/*  RETURNS:            array: the input with col's cells replaced in place by the function's values, one row per value; rows keep their order
    PARAMETERS:
        array           (Required) A 2D array or range.
        col             (Required) One column index; negative counts from the end (-1 = last). Not a whole number in 1..columns (either way), or more than one value: #VALUE!.
        function        (Required) A LAMBDA taking one cell and returning a list: a column as-is, a row or a 2D block read row by row (TOCOL). Values stay as it returns them (TEXTSPLIT gives text). Or a text delimiter: EXPANDROWS(a, 3, ";") splits by it, empty pieces ignored ("a;;b;" gives a, b).
        keep_empty      (Optional) FALSE (default) drops a row whose function result is a lone "" or a lone error (an empty FILTER is #CALC!); TRUE keeps it with a blank value. A blank or "" source cell always keeps its row, blank, and an error source cell keeps its row with that error; the function is not called on either. Every row dropped gives #CALC!.
    EXAMPLE:            =EXPANDROWS({"A",1,"x;y";"B",2,"z"}, 3, LAMBDA(v, TEXTSPLIT(v,,";"))) -> {"A",1,"x";"A",1,"y";"B",2,"z"}
    REVISIONS:          Date        Developer   Description
                        2026-11-24  Claude      Initial version (Tim's design, excel-esports #20); review: col checked, source errors kept, delimiter ignores empty pieces
*/
EXPANDROWS = LAMBDA(
//  Parameter Declarations
    [array],
    [col],
    [function],
    [keep_empty],
    LET(
    //  Procedure
        n, COLUMNS(array),
        c, IF(col < 0, n + col + 1, col),
        badCol?, IF(ROWS(col) * COLUMNS(col) <> 1, TRUE, OR(c <> INT(c), c < 1, c > n)),
        delim?, ISTEXT(function),
        keep?, IF(ISOMITTED(keep_empty), FALSE, keep_empty),
    //  One source row -> (row id, value) pairs; id 0 marks a dropped row
        leaf, LAMBDA(i, LET(
                    v, INDEX(array, i, c),
                    IF(ISERROR(v), HSTACK(i, IF({1}, v)),
                    IF(v = "",
                        HSTACK(i, ""),
                        LET(
                            raw, IF(delim?, TEXTSPLIT(v, , function, TRUE), function(v)),
                            lone?, IFERROR(ROWS(raw) * COLUMNS(raw) = 1, TRUE),
                            empty?, IF(lone?, IFERROR(INDEX(raw, 1, 1) = "", TRUE), FALSE),
                            IF(empty?,
                                HSTACK(IF(keep?, i, 0), ""),
                                LET(r, TOCOL(raw), HSTACK(IF(SEQUENCE(ROWS(r)), i), r))
                            )
                        )
                    ))
                )),
    //  Halve and stack: each row's function runs once and no stack grows row by row
        go, LAMBDA(self, lo, hi,
                IF(lo = hi,
                    leaf(lo),
                    LET(mid, INT((lo + hi) / 2), VSTACK(self(self, lo, mid), self(self, mid + 1, hi)))
                )),
        pairs, go(go, 1, ROWS(array)),
        keep, TAKE(pairs, , 1) > 0,
        kept, FILTER(pairs, keep),
    //  Every row dropped: FILTER's #CALC! alone, not a row of it
        IF(badCol?, VALUE("x"),
            IF(OR(keep),
                IF(SEQUENCE(1, n) = c, DROP(kept, , 1), CHOOSEROWS(array, TAKE(kept, , 1))),
                kept
            )
        )
)
);

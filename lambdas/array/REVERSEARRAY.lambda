/*  FUNCTION NAME:      REVERSEARRAY
    DESCRIPTION:*//**Reverses elements of a 1D or 2D array along the specified axis.*/
/*  RETURNS:            array: the input reversed along the chosen axis (both by default), same shape
    PARAMETERS:
        array           (Required) A 1D or 2D array to reverse.
        axis            (Optional) 0 = both axes (default), 1 = horizontal (reverse columns), 2 = vertical (reverse rows).
    EXAMPLE:            =REVERSEARRAY({1,2;3,4}) -> {4,3;2,1}
    REVISIONS:          Date        Developer   Description
                        2026-04-16  Claude      Initial version
                        2026-05-10  Claude      Fix 2D arrays + add axis parameter
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
REVERSEARRAY = LAMBDA(
//  Parameter Declarations
    [array],
    [axis],
    LET(
    //  Procedure
        n, ROWS(array),
        m, COLUMNS(array),
        ax, IF(ISOMITTED(axis), 0, axis),
        flipRows, OR(ax=0, ax=2),
        flipCols, OR(ax=0, ax=1),
        rowIdx, IF(flipRows, SEQUENCE(n,,n,-1), SEQUENCE(n)),
        colIdx, IF(flipCols, SEQUENCE(1,m,m,-1), SEQUENCE(1,m)),
        result, INDEX(array, rowIdx, colIdx),
        result
)
);

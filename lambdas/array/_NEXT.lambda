/*  FUNCTION NAME:      _NEXT
    DESCRIPTION:*//**For each element of a 1-D array, returns its next neighbour as a same-size, same-orientation array; the trailing n slots are padded. Pad-only sugar over SHIFT. (Underscore prefix because NEXT is a reserved Excel name.)*/
/*  REVISIONS:          Date        Developer   Description
                        2026-06-20  Claude      Initial version
                        2026-06-20  Claude      Renamed NEXT -> _NEXT (Excel reserves the bare name NEXT; the underscore form injects and still shows in IntelliSense)
*/
_NEXT = LAMBDA(
//  Parameter Declarations
    [array],
    [fill],
    [n],
//  Help
    LET(Help, TEXTSPLIT(
                "FUNCTION:      →_NEXT(array, [fill], [n])¶" &
                "DESCRIPTION:   →For each element of a 1-D array, returns its next neighbour (the element n positions later) as a same-size, same-orientation array; the trailing n slots are padded. Pad-only sugar over SHIFT — for a cyclic look-ahead use SHIFT directly with mode 1 (wrap). Named with a leading underscore because NEXT is a reserved Excel name.¶" &
                "VERSION:       →Jun 20 2026¶" &
                "PARAMETERS:    →¶" &
                "   array          →(Required) A 1-D array/range. Treated as a row when ROWS(array)=1 and COLUMNS(array)>1; otherwise as a column.¶" &
                "   fill           →(Optional) Boundary fill value for the exposed trailing slots. Default blank """".¶" &
                "   n              →(Optional) Shift distance. Default 1 = immediate neighbour.¶" &
                "EXAMPLE:       →¶" &
                "Formula        →=_NEXT({6,3,6,1,2})¶" &
                "Result         →{3,6,1,2,""""}",
                "→", "¶"
                ),
    //  Check inputs
        Help?, ISOMITTED(array),
    //  Procedure
        horiz, AND(ROWS(array) = 1, COLUMNS(array) > 1),
        shiftN, IF(ISOMITTED(n), 1, n),
        fillVal, IF(ISOMITTED(fill), "", fill),
        result, IF(horiz,
                    SHIFT(array, 0, -shiftN, 0, fillVal),
                    SHIFT(array, -shiftN, 0, 0, fillVal)),
        IF(Help?, Help, result)
)
);

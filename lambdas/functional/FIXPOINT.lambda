/*  FUNCTION NAME:      FIXPOINT
    DESCRIPTION:*//**Applies fn repeatedly until the value stops changing, then returns the converged state.*/
/*  RETURNS:            value: the state once fn stops changing it (#N/A if max_iter is hit)
    PARAMETERS:
        init            (Required) Starting value - scalar or array.
        fn              (Required) LAMBDA(state) returning the next state.
        same            (Optional) LAMBDA(a, b) returning TRUE when converged. Default: exact shape plus element-wise equality, so growing arrays are handled.
        max_iter        (Optional) Iteration cap, default 1000. Returns #N/A instead of hanging when convergence never fires.
    EXAMPLE:            =FIXPOINT(40, LAMBDA(x, IF(x>5, x/2, x))) -> 5
    REVISIONS:          Date        Developer   Description
                        2026-07-22  Claude      Initial version
                        2026-11-09  Claude      Help table removed from the formula; its text is the header metadata the argument hints read (#381, #382)
*/
FIXPOINT = LAMBDA(
//  Parameter Declarations
    [init],
    [fn],
    [same],
    [max_iter],
    LET(
    //  Procedure
        eq, IF(ISOMITTED(same),
                LAMBDA(a, b, IFERROR(AND(ROWS(a) = ROWS(b), COLUMNS(a) = COLUMNS(b), AND(a = b)), FALSE)),
                same),
        iterCap, IF(ISOMITTED(max_iter), 1000, max_iter),
        rec, LAMBDA(self, state, n,
                LET(nextState, fn(state),
                    IF(eq(nextState, state), state,
                       IF(n <= 0, NA(),
                          self(self, nextState, n - 1))))),
        result, rec(rec, init, iterCap),
        result
)
);

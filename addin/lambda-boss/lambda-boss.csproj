<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LambdaBoss</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ExcelDnaPackCompressResources>false</ExcelDnaPackCompressResources>
    <ExcelDna64Bit>true</ExcelDna64Bit>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="lambda-boss.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 ships these as framework assemblies but SDK-style projects don't reference them by default -->
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.*" />
    <PackageReference Include="gong-wpf-dragdrop" Version="3.2.*" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.*" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="PolySharp" Version="1.14.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="8.0.*" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

</Project>

<Window x:Class="LambdaBoss.UI.StateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lambda Boss — State"
        Width="620" Height="640"
        WindowStyle="ToolWindow"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1e1e1e"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="#2d2d2d" />
            <Setter Property="Foreground" Value="#cccccc" />
            <Setter Property="CaretBrush" Value="#cccccc" />
            <Setter Property="BorderBrush" Value="#3e3e3e" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#dcdcaa" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="190" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Foreground="#9cdcfe"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}">
            <Run Text="Variables" />
            <Run Text="   ticked = the answer, top to bottom" FontWeight="Normal" FontSize="11" Foreground="#808080" />
        </TextBlock>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <StackPanel x:Name="RowsPanel" />
                <TextBlock x:Name="DebugText"
                           Foreground="#808080"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Form" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
            <ComboBox x:Name="FormBox"
                      Grid.Column="1"
                      FontSize="13"
                      ToolTip="LET step unfolds the engine into the cell; the rest wrap the step in that fold"
                      SelectionChanged="Form_SelectionChanged" />
            <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
            <TextBox x:Name="NameBox"
                     Grid.Column="3"
                     ToolTip="Blank keeps the step inline. A name stores it as a named LAMBDA"
                     TextChanged="Field_TextChanged" />
            <CheckBox x:Name="DebugBox"
                      Grid.Column="4"
                      Content="_Debug"
                      Foreground="#dcdcaa"
                      FontSize="13"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      ToolTip="Alt+D toggles and saves. On: the fold runs as a SCAN inside SplitState(…, 1), so every step shows. Off: back to the REDUCE, and the debug-only outputs are dropped"
                      Checked="Debug_Changed"
                      Unchecked="Debug_Changed" />
        </Grid>

        <TextBlock x:Name="MessageText"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBox x:Name="PreviewBox"
                 Grid.Row="5"
                 Margin="0,8,0,0"
                 Padding="8"
                 FontSize="13"
                 IsReadOnly="True"
                 IsTabStop="False"
                 AcceptsReturn="True"
                 Background="#252526"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    Padding="16,4"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    Foreground="#cccccc"
                    BorderBrush="#3e3e3e"
                    BorderThickness="1"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    DockPanel.Dock="Right"
                    Content="Save"
                    Padding="16,4"
                    Background="#0e639c"
                    Foreground="#ffffff"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="SaveButton_Click" />
            <TextBlock Foreground="#808080"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Type over a name to rename it; clear it or press ✕ to remove it; the last row adds one. Tick the answer's variables (Alt+A) and set their order with Alt+Up/Down. Alt+D toggles Debug and saves." />
        </DockPanel>
    </Grid>
</Window>

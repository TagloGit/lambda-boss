<Window x:Class="LambdaBoss.UI.GatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lambda Boss — Gather"
        Width="640" Height="540"
        WindowStyle="ToolWindow"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1e1e1e"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="WalkHintText"
                   Grid.Row="0"
                   FontSize="12"
                   FontStyle="Italic"
                   Foreground="#9cdcfe"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Sink"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#dcdcaa"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="SinkAddressText"
                   Grid.Row="2"
                   Padding="6,4"
                   FontSize="13"
                   FontFamily="Consolas"
                   Background="#2d2d2d"
                   Foreground="#cccccc" />

        <TextBlock Grid.Row="3"
                   Text="Original formula"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#dcdcaa"
                   Margin="0,12,0,4" />

        <TextBox x:Name="OriginalFormulaText"
                 Grid.Row="4"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 Padding="6,4"
                 FontSize="12"
                 FontFamily="Consolas"
                 Background="#2d2d2d"
                 Foreground="#cccccc"
                 BorderBrush="#3e3e3e"
                 BorderThickness="1"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 MaxHeight="80" />

        <TextBlock Grid.Row="5"
                   Text="Bindings"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#dcdcaa"
                   Margin="0,12,0,4" />

        <StackPanel Grid.Row="6">
            <Border Background="#252526"
                    BorderBrush="#3e3e3e"
                    BorderThickness="1"
                    MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BindingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <!-- Address: 56 for the address itself plus
                                             14 of slack absorbing a slice row's
                                             indent (GatherRowVm.SliceIndentPixels). -->
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <!-- Auto, not a fixed 18: an unflagged row
                                             collapses the marker column to nothing
                                             and gives the width back to Rhs. All
                                             markers still line up, since the column
                                             is last and Rhs is the star. -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IncludeCheckboxVisibility}"
                                              VerticalAlignment="Center"
                                              Cursor="Hand"
                                              ToolTip="Include in the synthesised LET" />
                                    <!-- Margin carries the slice-row indent, so a
                                         slice sits visibly under the anchor row
                                         the engine emitted it after. -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Address}"
                                               Margin="{Binding AddressIndent}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{Binding AddressBrush}"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="2"
                                                  Content="{Binding Role}"
                                                  IsChecked="{Binding IsStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding RoleToggleVisibility}"
                                                  Padding="6,1"
                                                  FontFamily="Consolas"
                                                  FontSize="11"
                                                  MinWidth="44"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  Foreground="{Binding RoleBrush}"
                                                  BorderBrush="#3e3e3e"
                                                  BorderThickness="1"
                                                  Cursor="Hand"
                                                  ToolTip="Click to flip between input and step" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Role}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{Binding RoleBrush}"
                                               Visibility="{Binding RoleStaticVisibility}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsNameReadOnly}"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             Foreground="{Binding NameBrush}"
                                             Background="#1e1e1e"
                                             BorderBrush="{Binding NameBorderBrush}"
                                             BorderThickness="1"
                                             Padding="4,1"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             GotFocus="NameTextBox_GotFocus"
                                             PreviewMouseLeftButtonDown="NameTextBox_PreviewMouseLeftButtonDown" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Rhs}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{Binding RhsBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Rhs}" />
                                    <!-- Straddling-range warning (spec 0010): the row
                                         is a normal, included range input; the marker
                                         only says it could not be made a slice. -->
                                    <TextBlock Grid.Column="5"
                                               Text="&#x26A0;"
                                               Width="18"
                                               FontSize="12"
                                               Foreground="#d7ba7d"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding StraddleWarningVisibility}"
                                               ToolTip="{Binding StraddleWarningText}" />
                                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Spec 0010: the frozen-geometry caveat, once under the list and
                 only when a slice row exists. Visibility is driven from
                 GatherWindow.BuildRowsFromBindings. -->
            <TextBlock x:Name="SliceNoteText"
                       Text="Slice positions are fixed at gather time — if the array later changes shape, the slice offsets don't follow."
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#9cdcfe"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="OrphansSection"
                    Grid.Row="7"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="Orphaned (re-include or promote a row above to bring them back)"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#9cdcfe"
                       Margin="0,0,0,4" />
            <Border Background="#252526"
                    BorderBrush="#3e3e3e"
                    BorderThickness="1"
                    MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="OrphansList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <!-- Matches the bindings list's widened
                                             address column so the two lists
                                             stay column-aligned. -->
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                    <!-- Empty 28px column to align with bindings list (no checkbox). -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Address}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{Binding AddressBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Role}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{Binding RoleBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Name}"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{Binding NameBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Rhs}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{Binding RhsBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Rhs}" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding OrphanHintText}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="#6a6a6a"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Grid Grid.Row="8" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Preview"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#dcdcaa"
                       Margin="0,0,0,4" />
            <TextBox Grid.Row="1"
                     x:Name="PreviewText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Padding="6,4"
                     FontSize="12"
                     FontFamily="Consolas"
                     Background="#252526"
                     Foreground="#cccccc"
                     BorderBrush="#3e3e3e"
                     BorderThickness="1"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <DockPanel Grid.Row="9" Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    Padding="16,4"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    Foreground="#cccccc"
                    BorderBrush="#3e3e3e"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    DockPanel.Dock="Right"
                    Content="Save"
                    Padding="16,4"
                    Cursor="Hand"
                    Background="#0e639c"
                    Foreground="#ffffff"
                    BorderThickness="0"
                    Click="SaveButton_Click" />
            <TextBlock x:Name="StatusText"
                       Foreground="#808080"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>

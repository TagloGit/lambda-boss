<Window x:Class="LambdaBoss.UI.StateEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lambda Boss — Edit state step"
        Width="560" Height="560"
        WindowStyle="ToolWindow"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#1e1e1e"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="#2d2d2d" />
            <Setter Property="Foreground" Value="#cccccc" />
            <Setter Property="CaretBrush" Value="#cccccc" />
            <Setter Property="BorderBrush" Value="#3e3e3e" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#dcdcaa" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource ColumnLabel}" />
            <TextBlock Grid.Column="1" Text="Sample value" Style="{StaticResource ColumnLabel}" Margin="6,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>

        <TextBlock x:Name="MessageText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#e74856"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBox x:Name="PreviewBox"
                 Grid.Row="3"
                 Margin="0,8,0,0"
                 Padding="8"
                 FontSize="13"
                 IsReadOnly="True"
                 IsTabStop="False"
                 AcceptsReturn="True"
                 Background="#252526"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    Padding="16,4"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    Foreground="#cccccc"
                    BorderBrush="#3e3e3e"
                    BorderThickness="1"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    DockPanel.Dock="Right"
                    Content="Save"
                    Padding="16,4"
                    Background="#0e639c"
                    Foreground="#ffffff"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="SaveButton_Click" />
            <TextBlock Foreground="#808080"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Type a new name to rename. Clear it, or press ✕, to remove. The last row adds." />
        </DockPanel>
    </Grid>
</Window>
